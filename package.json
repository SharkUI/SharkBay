{
  "name": "sharkbay",
  "version": "1.0.0",
  "private": true,
  "description": "A local macOS control panel for software projects.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:runtime && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.node.json --watch --preserveWatchOutput\" \"wait-on tcp:5184 dist-electron/electron/main.js && electron .\"",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run --maxWorkers=1",
    "build": "npm run build:runtime && npm run build:desktop && vite build",
    "pack": "npm run build:desktop && vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "dist": "npm run build:desktop && vite build && electron-builder --mac",
    "pack:runtime": "npm run build:runtime && vite build && node scripts/pack-runtime-npm.mjs",
    "pack:runtime:migration": "npm run build:runtime && vite build && node scripts/pack-macos-migration-runtime.mjs",
    "pack:desktop:migration": "node scripts/pack-macos-migration-desktop.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "start:runtime": "node dist-runtime/src/server/main.js",
    "verify:webui": "npm run build:runtime && vite build && node scripts/verify-webui-runtime.mjs",
    "prepare:runtime": "node scripts/prepare-runtime-bundle.mjs",
    "verify:shared": "npm run build && node scripts/verify-shared-runtime.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:host": "vitest run --config vitest.host.config.ts --maxWorkers=1",
    "test:integration": "vitest run --config vitest.integration.config.ts --maxWorkers=1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "telegramify-markdown": "1.3.3",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.4.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1",
    "@types/ws": "^8.18.1",
    "react-test-renderer": "18.3.1",
    "@types/react-test-renderer": "^18.3.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "xyz.sharkbay.app",
    "productName": "SharkBay",
    "publish": {
      "provider": "github",
      "owner": "SharkUI",
      "repo": "SharkBay",
      "channel": "desktop"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "dist-electron/**/*",
      "!dist-electron/src/server/**/*",
      "!dist-electron/tests/**/*",
      "!dist-electron/**/*.map",
      "!dist-electron/**/*.d.ts",
      "!dist-electron/**/*.d.ts.map",
      "!dist-electron/**/*.tsbuildinfo",
      "!dist-electron/vite.config.*",
      "!dist-electron/vitest.config.*",
      "!dist-electron/vitest.*.config.*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.ts.map",
      "!node_modules/**/*.md",
      "!node_modules/bun-pty/**/*",
      "!node_modules/@lydell/node-pty*/**/*",
      "!node_modules/better-sqlite3/**/*",
      "src/island/**/*",
      "src/find-popover/**/*",
      "package.json",
      "resources/orca-status-NOTICE.txt"
    ],
    "extraResources": [
      {
        "from": "resources/shark-morning.png",
        "to": "resources/shark-morning.png"
      },
      {
        "from": "resources/shark-day.png",
        "to": "resources/shark-day.png"
      },
      {
        "from": "resources/shark-night.png",
        "to": "resources/shark-night.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "SharkBay needs Automation access so project terminals can run local tools that inspect and control apps at your request."
      },
      "icon": "resources/shark-morning.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "icon": "resources/shark-morning.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "npmRebuild": false
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
